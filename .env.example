# Frontend (add to apps/web/.env or Vercel env vars):
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
# VITE_APP_URL=https://yoursite.vercel.app  (for share links)
# VITE_APP_ENV=production                   (set to "production" in Vercel, leave blank locally)

# Sentry error monitoring (Vercel env vars — required for production error tracking):
# VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
#   → Find this in: sentry.io → Your Project → Settings → Client Keys (DSN)
# SENTRY_AUTH_TOKEN=sntrys_...
#   → Find this in: sentry.io → Settings → Auth Tokens → Create new token
#   → Required scopes: project:releases, org:read
# SENTRY_ORG=your-sentry-org-slug
#   → The short name in your Sentry URL: sentry.io/organizations/<slug>/
# SENTRY_PROJECT=experience-caddie-web
#   → The project name you created inside Sentry

# Local scripts only (e.g. scripts/seed-featured-packages.mjs — never commit real values):
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...   (Dashboard → Project Settings → API → service_role — rotate if leaked)

# Supabase Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets):
# TICKETMASTER_API_KEY=...  (for search – real concert data)
# RESEND_API_KEY=...        (for send-share-email)
# FROM_EMAIL=...            (for send-share-email)
# PERPLEXITY_API_KEY=...    (for generate-itinerary)
